{
  "name": "api-hit-monitoring",
  "version": "1.0.0",
  "description": "Real time API hit monitoring system built with Node.js, Express, MongoDB, PostgreSQL, RabbitMQ, and Winston for logging. This application tracks and logs API requests, providing insights into usage patterns and performance metrics.",
