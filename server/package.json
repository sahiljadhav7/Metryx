  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "processor": "node src/modules/processor/consumer.js",
    "init": "node init-system.js",
    "init:env": "node init-system.js --generate-env"
  },
  "dependencies": {
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
